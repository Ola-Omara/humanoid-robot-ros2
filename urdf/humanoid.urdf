<?xml version="1.0"?>
<robot name="humanoid_robot">

  <!-- Main Base Link containing all visual components of the Humanoid -->
  <link name="base_link">
    <!-- Torso -->
    <visual>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.22 0.3"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <!-- Head -->
    <visual>
      <origin xyz="0 0 0.47" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.07"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>

    <!-- Left Arm -->
    <visual>
      <origin xyz="0 0.15 0.25" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.25"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>

    <!-- Right Arm -->
    <visual>
      <origin xyz="0 -0.15 0.25" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.25"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <!-- Left Leg -->
    <visual>
      <origin xyz="0 0.06 -0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.35"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>

    <!-- Right Leg -->
    <visual>
      <origin xyz="0 -0.06 -0.1" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.35"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

</robot>
